# Inject using Ansible Vault or your secret store; never commit production secrets.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-from-a-secret-store
DJANGO_ALLOWED_HOSTS=games.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://games.example.com
DJANGO_TRUST_PROXY=true
DJANGO_DEBUG=false
DJANGO_DB_PATH=/data/db.sqlite3
AI_PROVIDER=ollama
AI_BASE_URL=http://ai.np.fruck.name:11434
AI_MODEL=gemma3:1b
AI_LANGUAGE=German
# Optional for a provider requiring bearer authentication:
AI_API_KEY=
